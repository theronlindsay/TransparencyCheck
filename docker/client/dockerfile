FROM docker.io/oven/bun:1 AS build

WORKDIR /app

# Copy root and app package files
COPY package.json bun.lock ./
COPY apps/client/package.json ./apps/client/
COPY apps/server/package.json ./apps/server/

# Install all dependencies (workspace aware)
RUN bun install --frozen-lockfile

COPY . .

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# svelte-kit sync was skipped/failed during bun install (sources not copied yet).
RUN cd apps/client && bun run prepare

# Build client only
RUN bun run build:client

FROM docker.io/oven/bun:1 AS runtime

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

COPY --from=build /app/apps/client/build ./build
COPY docker/client/serve.js ./serve.js

EXPOSE 8080

CMD ["bun", "serve.js"]
