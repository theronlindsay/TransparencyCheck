# Shared routing for the public site. Included by the active server block(s).
# Rendered to /etc/nginx/conf.d/app-proxy.inc — the ".inc" extension matters,
# nginx auto-includes conf.d/*.conf at http level and location blocks are not
# valid there.

# Resolve upstreams at request time (see render-config.sh) so a restarting
# server/client container can never keep the whole proxy from starting.
resolver ${RESOLVER} valid=10s ipv6=off;
resolver_timeout 5s;

# Bug-report screenshots are uploaded through /api/uploadthing.
client_max_body_size 25m;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json
	application/manifest+json application/wasm image/svg+xml;

location = /healthz {
	access_log off;
	default_type text/plain;
	return 200 "ok\n";
}

# API, auth and uploads -> SvelteKit node server.
location /api/ {
	set $tc_api server:3000;
	proxy_pass http://$tc_api$request_uri;
	proxy_http_version 1.1;

	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $host;
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;

	# The API emits its own origin-allowlisted, credentials-enabled CORS headers
	# (apps/server/src/hooks.server.js). Do not rewrite them here: a wildcard
	# Access-Control-Allow-Origin is invalid alongside credentials and breaks
	# cookie auth for the Capacitor app.

	# AI summaries stream for a while; the 60s default cuts them off.
	proxy_connect_timeout 10s;
	proxy_send_timeout 300s;
	proxy_read_timeout 300s;
	proxy_buffering off;
	proxy_cache_bypass $http_upgrade;
}

# Everything else -> static PWA served by the client container.
location / {
	set $tc_client client:80;
	proxy_pass http://$tc_client$request_uri;
	proxy_http_version 1.1;

	proxy_set_header Host $host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_connect_timeout 10s;
	proxy_read_timeout 60s;
}
