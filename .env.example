# TransparencyCheck configuration.
#
# Do not edit this file for your deployment — run ./init.sh, which copies it to
# .env, generates every secret marked "generated by init.sh", and fills in the
# domain-derived values. Re-running init.sh never overwrites values you have set.
#
# .env is gitignored. Keep it out of version control.

# ─── Deployment / domain ──────────────────────────────────────────────────────
# Leave DOMAIN empty to serve plain HTTP on the machine's IP (no certificate).
# Set it (and LETSENCRYPT_EMAIL) to get automatic HTTPS via Let's Encrypt.
DOMAIN=
# Subdomain for the admin panel. init.sh sets this to admin.$DOMAIN when that
# name already resolves to this host, since it has to be in the certificate.
ADMIN_DOMAIN=
# Email used for Let's Encrypt registration and expiry warnings.
LETSENCRYPT_EMAIL=
# Host ports for the edge proxy. Only change these if something else on the VPS
# already owns 80/443 (a certificate cannot be issued on non-standard ports).
HTTP_PORT=80
HTTPS_PORT=443

# ─── Required credentials ─────────────────────────────────────────────────────
# Congress.gov API key: https://api.congress.gov/sign-up/
# DEMO_KEY works for a handful of requests, then rate-limits hard.
CONGRESS_API_KEY=DEMO_KEY
# Bill summaries and the AI assistant are empty without one of these.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# MONGO_ROOT_PASSWORD is generated by init.sh. Compose refuses to start without
# it, so the old shared "password123" default can no longer reach production.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=
# Leave DATABASE_URL empty to use the bundled mongodb container. Set it to point
# at an external/managed MongoDB instead; compose then uses your value verbatim.
DATABASE_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET is generated by init.sh. Changing it invalidates every
# existing session, so do not rotate it casually.
BETTER_AUTH_SECRET=
# Public origin of the site, e.g. https://example.com. Used for OAuth callbacks.
BETTER_AUTH_URL=
# Extra origins allowed to complete auth flows, comma separated. init.sh fills in
# your domain; localhost and transparencycheck.app are always trusted in code.
BETTER_AUTH_TRUSTED_ORIGINS=
# Extra origins allowed for cross-origin API calls, comma separated. Needed for
# the Capacitor app and any separately hosted frontend.
CORS_ORIGINS=

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Generated by init.sh. Admin routes return HTTP 500 until this is set.
ADMIN_PANEL_PASSWORD=
# Extra hostnames allowed to serve /admin, comma separated. init.sh fills this in
# from ADMIN_DOMAIN; localhost and 127.0.0.1 are always allowed in code.
ADMIN_PANEL_HOSTS=
# Optional: file the admin log viewer reads from.
ADMIN_LOG_FILE=/app/logs/server.log

# ─── Cron endpoints ───────────────────────────────────────────────────────────
# Generated by init.sh. Required as ?secret=... by /api/cron/* endpoints.
CRON_SECRET=

# ─── Optional integrations ────────────────────────────────────────────────────
# GitHub social login (both values required, or GitHub login stays disabled).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Stripe subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# UploadThing (bug-report screenshot uploads).
UPLOADTHING_TOKEN=
# OpenFEC campaign finance sync: https://api.open.fec.gov/developers/
OPENFEC_API_KEY=
# Financial Modeling Prep (congressional stock trades).
FMP_API_KEY=

# ─── Tuning ───────────────────────────────────────────────────────────────────
# Leave these commented out to use the code defaults. Uncomment with a real
# number if you need to change one — an empty value is not the same as unset.
# ADMIN_CAPTURE_LOG_LIMIT=1200
# CONGRESS_MEMBER_SYNC_CONCURRENCY=6
# FEC_BULK_DOWNLOAD_TIMEOUT_MS=120000
# OPENFEC_SYNC_PROFILE_LIMIT=
# FMP_STOCK_PAGE_LIMIT=25
# FMP_STOCK_MAX_PAGES=1

# ─── Client build ─────────────────────────────────────────────────────────────
# Leave empty for the Docker deployment: the PWA then calls /api on its own
# origin through the proxy. Only set this when building the Capacitor app
# against a remote API (e.g. https://example.com).
VITE_API_BASE_URL=
