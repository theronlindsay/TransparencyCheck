# Create A records (and only working AAAA records) pointing these names to the VPS.
APP_DOMAIN=transparencycheck.app
API_DOMAIN=api.transparencycheck.app
ADMIN_DOMAIN=admin.transparencycheck.app
ACME_EMAIL=
# Optional: use Let's Encrypt staging while testing DNS/routing.
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Generate each separately with: openssl rand -hex 32
# Use hex for Mongo passwords because MONGO_APP_PASSWORD is embedded in a URI.
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
BETTER_AUTH_SECRET=
ADMIN_PANEL_PASSWORD=
CRON_SECRET=

CONGRESS_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENFEC_API_KEY=
FMP_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UPLOADTHING_TOKEN=

# Full national contribution imports are opt-in on small VPSs.
FEC_BULK_FINANCE_ENABLED=false
SERVER_MEMORY_LIMIT=384m
MONGO_IMAGE=mongo:7.0
MONGO_MEMORY_LIMIT=640m
MONGO_CACHE_GB=0.25
CLIENT_MEMORY_LIMIT=96m
PROXY_MEMORY_LIMIT=128m
