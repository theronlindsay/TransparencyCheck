{
	"name": "transparencycheck-monorepo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.11",
	"scripts": {
		"init": "./init.sh",
		"dev:client": "cd apps/client && bun run dev",
		"dev:server": "cd apps/server && bun run dev",
		"build:client": "cd apps/client && bun run build",
		"build:server": "cd apps/server && bun run build",
		"build": "bun run build:client && bun run build:server",
		"install:all": "bun install",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"compose": "./scripts/compose.sh",
		"docker:build": "./scripts/compose.sh build",
		"docker:up": "./scripts/compose.sh up -d",
		"docker:down": "./scripts/compose.sh down",
		"docker:logs": "./scripts/compose.sh logs -f",
		"docker:restart": "./scripts/compose.sh restart",
		"docker:ps": "./scripts/compose.sh ps",
		"deploy": "./scripts/compose.sh up -d --build --remove-orphans"
	},
	"workspaces": [
		"apps/client",
		"apps/server"
	],
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.22.0",
		"eslint": "^9.22.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3"
	},
	"dependencies": {
		"better-auth": "^1.5.6"
	}
}
